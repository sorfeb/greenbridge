# fish completion for gbridge, generated by: gbridge completion fish
# Install it:  gbridge completion fish > ~/.config/fish/completions/gbridge.fish

complete -c gbridge -f
{{- range .Commands}}
complete -c gbridge -n 'not __fish_seen_subcommand_from {{$.Names}}' -a {{.Name}} -d '{{fq .Summary}}'
{{- end}}
complete -c gbridge -n '__fish_seen_subcommand_from completion' -a '{{.Shells}}'
{{- range $c := .Commands}}{{range $c.Flags}}
complete -c gbridge -n '__fish_seen_subcommand_from {{$c.Name}}' -l {{.Name}}
{{- if .Dir}} -x -a '(__fish_complete_directories)'{{else if .Value}} -x{{end}} -d '{{fq .Usage}}'
{{- end}}{{end}}
