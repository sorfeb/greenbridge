#compdef gbridge
# zsh completion for gbridge, generated by: gbridge completion zsh
# Load it from ~/.zshrc, after compinit:  source <(gbridge completion zsh)

_gbridge() {
  local -a commands
  commands=(
{{- range .Commands}}
    '{{.Name}}:{{sq .Summary}}'
{{- end}}
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'gbridge command' commands
    return
  fi
  local cmd=$words[2]
  shift words
  (( CURRENT-- ))
  case $cmd in
{{- range .Commands}}{{if .Words}}
    {{.Name}})
      _arguments '1:{{.Name}} argument:({{.Words}})'
      ;;
{{- else if .Flags}}
    {{.Name}})
      _arguments
{{- range .Flags}} \
        '{{if .Repeat}}*{{end}}--{{.Name}}{{if .Value}}=[{{zq .Usage}}]:{{.Name}}:{{if .Dir}}_directories{{else}} {{end}}{{else}}[{{zq .Usage}}]{{end}}'
{{- end}}
      ;;
{{- end}}{{end}}
  esac
}

if [[ $funcstack[1] == _gbridge ]]; then
  _gbridge "$@"
else
  compdef _gbridge gbridge
fi
