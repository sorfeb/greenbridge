# bash completion for gbridge, generated by: gbridge completion bash
# Load it from ~/.bashrc:  source <(gbridge completion bash)

_gbridge() {
    local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W '{{.Names}}' -- "$cur"))
        return
    fi
    case ${COMP_WORDS[1]} in
{{- range .Commands}}{{if .Words}}
    {{.Name}})
        [[ $COMP_CWORD -eq 2 ]] && COMPREPLY=($(compgen -W '{{.Words}}' -- "$cur"))
        ;;
{{- else if .Flags}}
    {{.Name}})
        case $prev in
{{- with pattern .Flags true}}
        {{.}})
            local IFS=$'\n'
            compopt -o filenames 2>/dev/null
            COMPREPLY=($(compgen -d -- "$cur"))
            return
            ;;
{{- end}}
{{- with pattern .Flags false}}
        {{.}}) return ;;
{{- end}}
        esac
        COMPREPLY=($(compgen -W '{{words .Flags}}' -- "$cur"))
        ;;
{{- end}}{{end}}
    esac
}

complete -F _gbridge gbridge
