# PowerShell completion for gbridge, generated by: gbridge completion powershell
# Load it from $PROFILE:  gbridge completion powershell | Out-String | Invoke-Expression

Register-ArgumentCompleter -Native -CommandName gbridge, gbridge.exe -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $commands = [ordered]@{
{{- range .Commands}}
        '{{.Name}}' = '{{pq .Summary}}'
{{- end}}
    }
    # Per command: flag, description, and whether it takes a value.
    $flags = @{
{{- range .Commands}}{{if .Flags}}
        '{{.Name}}' = @(
{{- range .Flags}}
            , @('--{{.Name}}', '{{pq .Usage}}', ${{.Value}})
{{- end}}
        )
{{- end}}{{end}}
    }
    # Per command: the values its first argument takes.
    $values = @{
{{- range .Commands}}{{if .Words}}
        '{{.Name}}' = '{{pq .Words}}'
{{- end}}{{end}}
    }

    # Words before the cursor, minus the one being completed.
    $words = @($commandAst.CommandElements |
        Where-Object { $_.Extent.StartOffset -lt $cursorPosition } |
        ForEach-Object { $_.ToString() })
    if ($wordToComplete -and $words.Count -gt 1) { $words = $words[0..($words.Count - 2)] }

    $result = { param($text, $tip)
        [System.Management.Automation.CompletionResult]::new($text, $text, 'ParameterValue', $tip) }

    if ($words.Count -eq 1) {
        foreach ($c in $commands.GetEnumerator()) {
            if ($c.Key -like "$wordToComplete*") { & $result $c.Key $c.Value }
        }
        return
    }
    if ($values[$words[1]]) {
        if ($words.Count -eq 2) {
            foreach ($v in $values[$words[1]].Split(' ')) { if ($v -like "$wordToComplete*") { & $result $v $v } }
        }
        return
    }
    $spec = $flags[$words[1]]
    if (-not $spec) { return }
    # After a flag that takes a value, return nothing: PowerShell falls back to paths.
    foreach ($f in $spec) { if ($f[2] -and $f[0] -eq $words[-1]) { return } }
    foreach ($f in $spec) { if ($f[0] -like "$wordToComplete*") { & $result $f[0] $f[1] } }
}
