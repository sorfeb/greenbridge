#!/bin/sh
# Copied under every other hook name. A global core.hooksPath hides
# .git/hooks for all events, so without these, pre-commit, commit-msg,
# git-lfs's post-checkout and friends silently stop running in every repo.
h="$(git rev-parse --git-common-dir)/hooks/$(basename "$0")"
[ -x "$h" ] && exec "$h" "$@"
exit 0
